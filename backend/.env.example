DATABASE_URL=postgresql+asyncpg://user:pass@localhost/shortstamp
JWT_SECRET=change-me-to-a-random-256-bit-secret
CORS_ORIGINS=["http://localhost:3000"]

# Ingestion pipeline
ENABLE_SCHEDULER=false
WALMART_API_KEY=
WALMART_PRIVATE_KEY_PATH=../secrets/walmart_private.pem
MAX_PAGES_PER_TERM=5
PAGE_SIZE=50

# Legacy keys (kept for backward compat)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
SERPAPI_KEY=
