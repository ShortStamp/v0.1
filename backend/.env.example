# Supabase / hosted PostgreSQL (Transaction Pooler — use port 6543 for the backend API)
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_SSL=true

# Local development alternative (SQLite)
# DATABASE_URL=sqlite+aiosqlite:///./shortstamp.db
# DATABASE_SSL=false

JWT_SECRET=change-me-to-a-random-256-bit-secret
CORS_ORIGINS=["http://localhost:3000"]

# Ingestion pipeline
ENABLE_SCHEDULER=false
ENABLE_RETAILER_SCRAPER=false
RETAILER_SCRAPE_MAX_PAGES_PER_TERM=1
RETAILER_SCRAPE_TERMS=
RETAILER_SCRAPE_DETAIL_ENRICH_PER_RETAILER=25
WALMART_API_KEY=
WALMART_PRIVATE_KEY_PATH=../secrets/walmart_private.pem
MAX_PAGES_PER_TERM=5
PAGE_SIZE=50

# Legacy keys (kept for backward compat)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
SERPAPI_KEY=
